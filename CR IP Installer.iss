; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

#define MyAppName "Crysis Remastered Improvement Project"
#define MyAppVersion "1.0.1"
#define MyAppPublisher "Team MTL5"
#define MyAppURL "https://www.moddb.com/mods/improvement-project"
//#define InstallDataFolder "C:\\Crysis Remastered Improvement Project Build\\InstallData"

[Setup]
AppendDefaultDirName=no
AppId={{5825B7BF-803B-467A-9940-7323B6C9D508}}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName=C:\Program Files (x86)\Steam\steamapps\common\Crysis Remastered
DefaultGroupName={#MyAppName}
DirExistsWarning=no
OutputBaseFilename=ImprovementProject {#MyAppVersion}
SolidCompression=yes
WizardStyle=modern
DisableProgramGroupPage=yes
InfoBeforeFile=readme_before.rtf


[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Files]
Source: "Main\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
//Remember that Warhead map data is stored in patch2, and overrides patch1 where applicable.
Source: "Patch\patch1.pak"; DestDir: "{app}\Patch"; Flags: ignoreversion
Source: "Patch\patch2.pak"; DestDir: "{app}\Patch"; Check: ShouldInstallWarhead; Flags: ignoreversion


//We copy the localization files regardless.
Source: "Patch\Localized\*"; DestDir: "{app}\Patch\Localized"; Flags: ignoreversion recursesubdirs createallsubdirs
//First we copy the main level data.

//We copy the new loadscreens and cfg files to override disabling of distant NPCs. These unfortunately must overwrite the OGs.
Source: "Optional\zzzz_UKAudio.pak"; DestDir: "{app}\Game"; Check: ShouldInstallAudio; Flags: ignoreversion
Source: "Optional\zzzz_UKWeapons.pak"; DestDir: "{app}\Game"; Check: ShouldInstallModels; Flags: ignoreversion
Source: "Optional\zzzz_C2StyleSuitFX.pak"; DestDir: "{app}\Game"; Check: ShouldInstallC2StyleSuitFX; Flags: ignoreversion
//Source: "Optional\zzzz_RevisedSuitFX.pak"; DestDir: "{app}\Game"; Check: ShouldInstallRevisedSuitFX; Flags: ignoreversion
Source: "Optional\zzz_Warhead.pak"; DestDir: "{app}\Game"; Check: ShouldInstallWarhead; Flags: ignoreversion

Source: "option1_small.bmp"; DestDir: "{tmp}"; Flags: dontcopy
Source: "option1_full.png"; DestDir: "{tmp}"; Flags: dontcopy
Source: "option2_small.bmp"; DestDir: "{tmp}"; Flags: dontcopy
Source: "option2_full.wmv"; DestDir: "{tmp}"; Flags: dontcopy
Source: "option3_small.bmp"; DestDir: "{tmp}"; Flags: dontcopy
Source: "option3_full.png"; DestDir: "{tmp}"; Flags: dontcopy
Source: "option4_small.bmp"; DestDir: "{tmp}"; Flags: dontcopy
Source: "option4_full.png"; DestDir: "{tmp}"; Flags: dontcopy
Source: "option5_c2_small.bmp"; DestDir: "{tmp}"; Flags: dontcopy
Source: "option5_c2_full.png"; DestDir: "{tmp}"; Flags: dontcopy
Source: "option5_classic_small.bmp"; DestDir: "{tmp}"; Flags: dontcopy
Source: "option5_classic_full.png"; DestDir: "{tmp}"; Flags: dontcopy
//Source: "option5_revised_small.bmp"; DestDir: "{tmp}"; Flags: dontcopy
//Source: "option5_revised_full.png"; DestDir: "{tmp}"; Flags: dontcopy

//Backup is special case.
Source: "Backup\*"; DestDir: "{app}\ImprovementProjectBackup"; Flags: ignoreversion recursesubdirs createallsubdirs uninsneveruninstall



