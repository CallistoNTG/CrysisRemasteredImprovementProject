// Global variable declarations:
var
  FoundGameExePath: string;
  FoundInstallHint: string;
  GlobalDescriptionMemo: TMemo;
  OptionCheckBox1, OptionCheckBox2, OptionCheckBox3, OptionCheckBox4: TCheckBox;
  SuitHeader: TNewStaticText;
